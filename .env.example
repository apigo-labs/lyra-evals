VOHU_EVALS_GATEWAY_BASE_URL=https://api.example.com
VOHU_EVALS_API_KEY=replace-me
# Website 对外地址加 /platform；不要填写集群内 Platform Service 地址
VOHU_EVALS_PLATFORM_BASE_URL=https://website.example.com/platform
VOHU_EVALS_PLATFORM_TOKEN=replace-me
VOHU_EVALS_WORKSPACE_ID=replace-me
# JWT 过期时仅通过 Platform 官方登录接口刷新；凭据只保存在本地 .env
VOHU_USER_EMAIL=replace-me
VOHU_USER_PASSWORD=replace-me
