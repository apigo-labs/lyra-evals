{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidemind.dev/vohu-evals/evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "object",
      "required": ["score_percent", "total_cases", "completed_cases", "system_failed_cases", "invalid_output_cases", "total_cost_usd"]
    }
  },
  "additionalProperties": false
}
